# Plantilla de variables de entorno. Copiala como .env y ajusta los valores.
# El .env real esta en .gitignore: nunca se sube al repositorio.

# Base del API. En produccion debe ser una URL publica yTTPS, nunca una IP
# de red local: EXPO_PUBLIC_* se inyecta en el bundle, asi que queda visible
# para cualquiera que descargue la app.
EXPO_PUBLIC_API_BASE_URL=https://api.dogalert.mx

# Fecha mas antigua que puede tener el evento de un reporte (RF-015).
# Debe coincidir con la fecha de lanzamiento de DogAlert.
EXPO_PUBLIC_REPORT_MIN_EVENT_DATE=2026-10-02

# Durante el desarrollo se puede adelantar esta fecha para poder probar
# reportes del dia de hoy, por ejemplo: 2026-09-01
# OJO: si la adelantas, la app acepta eventos anteriores al lanzamiento, que
# es justo lo que RF-015 prohibe. No dejar ese valor en un build de entrega.
